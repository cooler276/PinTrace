  SUP -> CTRL [label="最終 setpoint"];
  SUP -> LLC [label="受付停止"];
  CRTP_RX -> LOC [label="port 6"];
  LOC -> PEER [label="他の機体の位置"];
  PEER -> CA [label="他の機体の位置"];
  CTRL -> PD [label="control"];
  PM -> PD [label="電池電圧"];
  PD -> DEV_MOT [label="PWM 比率", color="#2f6fb3", penwidth=1.6, label="PWM 比率\n(supervisor が許可)"];
  SUP -> DEV_MOT [label="停止", color="#2f6fb3", style=dashed];
  DEV_MOT -> P_TIM [label="比較レジスタ", color="#c05050", fontcolor="#c05050", penwidth=2];
  P_TIM -> K_MOT [label="PWM 信号", color="#c05050", fontcolor="#c05050", penwidth=2];
  S_DECK -> P_SPI1 [label="SPI 信号"];
  P_SPI1 -> DAPI [label="DMA 転送"];
  DAPI -> DDRV [label="デッキのデータ"];
  S_NRF -> P_USART6 [label="UART 信号", color="#c05050", fontcolor="#c05050", penwidth=2];
  P_USART6 -> UART [label="受信割り込み", color="#c05050", fontcolor="#c05050", penwidth=2];
  UART -> SLK_RX [label="syslink", color="#c05050", fontcolor="#c05050", penwidth=2];
  S_USB -> LINK_RX [label="CRTP (USB)", color="#c05050", fontcolor="#c05050", penwidth=2];
  SLK_RX -> LINK_RX [label="CRTP", color="#c05050", fontcolor="#c05050", penwidth=2];
  SLK_RX -> PM [label="電池の状態"];
  SLK_RX -> DMGR [label="1-Wire"];
  LINK_RX -> CRTP_RX [label="CRTP", color="#c05050", fontcolor="#c05050", penwidth=2];
  CRTP_RX -> PARAM [label="port 2", color="#c05050", fontcolor="#c05050", penwidth=2];
  CRTP_RX -> LOG [label="port 5 (設定)"];
  CRTP_RX -> MEM [label="port 4"];
  S_EEP -> P_I2C1 [label="I2C 信号"];
  P_I2C1 -> I2C1DRV [label="DMA 転送"];
  I2C1DRV -> DEV_EEP [label="バイト列"];
  DEV_EEP -> STO [label="保存値"];
  STO -> PBOOT [label="永続 param"];
  S_DECK -> DDRV [label="I2C (ToF など)"];
  DEV_EEP -> SENS [label="較正角 (configblock)"];
  DEV_EEP -> SLK_TX [label="無線の設定 (nRF51 へ)"];
  S_TIME -> SUP [label="経過時間 (タイムアウト)"];
  S_TIME -> PM [label="無操作時間"];
  S_TIME -> LOG [label="log の周期"];
  S_TIME -> HLC [label="軌道の時刻"];
