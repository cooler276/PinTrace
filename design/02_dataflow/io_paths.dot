// 入力 → 判断 → 出力（生成元: tools/io_paths.py）
digraph io {
  graph [rankdir=LR, nodesep=0.25, ranksep=0.8, fontname="Yu Gothic UI", splines=spline];
  node [shape=box, style="rounded,filled", fontname="Yu Gothic UI", fontsize=10, height=0.4];
  edge [fontname="Yu Gothic UI", fontsize=8, arrowsize=0.6, color="#7a9cc6"];
  subgraph cluster_in { label="入力源"; color="#999999"; style=dashed; rank=source;
    S_IMU [label="IMU・気圧計
BMI088 / BMP388\n［センサ］", fillcolor="#fff7cc", shape=box];
    S_DECK [label="デッキのセンサ\n［センサ］", fillcolor="#fff7cc", shape=box];
    S_EEP [label="EEPROM（読み出し）\n［記憶］", fillcolor="#fff7cc", shape=box];
    S_NRF [label="nRF51 からの受信
無線・電池・ボタン・1-Wire\n［通信］", fillcolor="#fff7cc", shape=box];
    S_USB [label="USB からの受信\n［通信］", fillcolor="#fff7cc", shape=box];
    S_TIME [label="時間
(tick・タイマ)\n［時間］", fillcolor="#fff7cc", shape=box];
  }
  subgraph cluster_out { label="出力先"; color="#999999"; style=dashed; rank=sink;
    K_MOT [label="モータ\n［アクチュエータ］", fillcolor="#e6f4d7"];
    K_LED [label="LED・ブザー\n［表示］", fillcolor="#e6f4d7"];
    K_EEP [label="EEPROM（書き込み）\n［記憶］", fillcolor="#e6f4d7"];
    K_NRF [label="nRF51 への送信
テレメトリ・シャットダウン応答\n［通信］", fillcolor="#e6f4d7"];
    K_USB [label="USB への送信\n［通信］", fillcolor="#e6f4d7"];
  }
  CA [label="L5: 衝突回避", fillcolor="#fdeef7"];
  CMD [label="L5: commander
(優先度管理)", fillcolor="#fdeef7"];
  CRTP_RX [label="L3: CRTP ルータ（受信）", fillcolor="#fff4e6"];
  CRTP_TX [label="L3: CRTP ルータ（送信）", fillcolor="#fff4e6"];
  CTRL [label="L5: 制御", fillcolor="#fdeef7"];
  DAPI [label="L4: デッキ API
GPIO / SPI / ADC", fillcolor="#eaf7f2"];
  DDRV [label="L4: デッキドライバ
Flow / Loco / LH ...", fillcolor="#eaf7f2"];
  DEV_EEP [label="L1D: EEPROM ドライバ
eeprom / configblock", fillcolor="#edf7e9"];
  DEV_IMU [label="L1D: IMU ドライバ
bmi088 / bmp3", fillcolor="#edf7e9"];
  DEV_MOT [label="L1D: モータドライバ
motors", fillcolor="#edf7e9"];
  DMGR [label="L4: デッキ管理
検出・照合", fillcolor="#eaf7f2"];
  EST [label="L5: 状態推定", fillcolor="#fdeef7"];
  EXTI [label="L1B: exti
割り込みの振り分け", fillcolor="#e3f1dc"];
  HLC [label="L5: high-level commander
+ planner", fillcolor="#fdeef7"];
  I2C1DRV [label="L1B: I2C1 ドライバ
i2cdev / i2c_drv", fillcolor="#e3f1dc"];
  I2C3DRV [label="L1B: I2C3 ドライバ
i2cdev / i2c_drv", fillcolor="#e3f1dc"];
  LINK_RX [label="L2: CRTP リンク（受信）", fillcolor="#e9f6fb"];
  LINK_TX [label="L2: CRTP リンク（送信）", fillcolor="#e9f6fb"];
  LLC [label="L5: 低レベル commander", fillcolor="#fdeef7"];
  LOC [label="L5: 測位
lighthouse / localization", fillcolor="#fdeef7"];
  LOG [label="L3: log", fillcolor="#fff4e6"];
  MEM [label="L3: mem", fillcolor="#fff4e6"];
  PARAM [label="L3: param（実行時の書き込み）", fillcolor="#fff4e6"];
  PBOOT [label="L3: param（起動時の永続値の復元）", fillcolor="#fff4e6"];
  PD [label="L5: 出力分配", fillcolor="#fdeef7"];
  PEER [label="L3: 周辺機体の位置テーブル
peer localization", fillcolor="#fff4e6"];
  PM [label="L2: 電源管理", fillcolor="#e9f6fb"];
  P_EXTI [label="HW: EXTI", fillcolor="#f2f2f2"];
  P_I2C1 [label="HW: I2C1 + DMA", fillcolor="#f2f2f2"];
  P_I2C3 [label="HW: I2C3 + DMA", fillcolor="#f2f2f2"];
  P_SPI1 [label="HW: SPI1 + DMA", fillcolor="#f2f2f2"];
  P_TIM [label="HW: TIM2 / TIM4
PWM", fillcolor="#f2f2f2"];
  P_USART6 [label="HW: USART6 + DMA", fillcolor="#f2f2f2"];
  SENS [label="L2: センサ統合", fillcolor="#e9f6fb"];
  SLK_RX [label="L2: syslink（受信）", fillcolor="#e9f6fb"];
  SLK_TX [label="L2: syslink（送信）", fillcolor="#e9f6fb"];
  STO [label="L2: ストレージ", fillcolor="#e9f6fb"];
  SUP [label="L5: supervisor", fillcolor="#fdeef7"];
  SYS [label="L3: system
起動・自己テスト", fillcolor="#fff4e6"];
  UART [label="L1B: uart_syslink
(USART6)", fillcolor="#e3f1dc"];
  S_IMU -> P_I2C3 [label="I2C 信号"];
  P_I2C3 -> I2C3DRV [label="DMA 転送"];
  I2C3DRV -> DEV_IMU [label="レジスタ値"];
  DEV_IMU -> SENS [label="生データ"];
  S_IMU -> P_EXTI [label="data ready (INT)"];
  P_EXTI -> EXTI [label="割り込み"];
  EXTI -> SENS [label="IMU 割り込み"];
  SENS -> EST [label="gyro / acc / baro"];
  SENS -> SUP [label="acc"];
  SENS -> CTRL [label="gyro"];
  DDRV -> EST [label="flow / 距離 / TDoA"];
  LOC -> EST [label="位置 / 姿勢 / sweep"];
  EST -> CMD [label="state"];
  EST -> HLC [label="state"];
  EST -> CA [label="state"];
  EST -> CTRL [label="state"];
  SUP -> EST [label="飛行中フラグ"];
  CRTP_RX -> LLC [label="port 3 / 7"];
  CRTP_RX -> HLC [label="port 8"];
  LLC -> CMD [label="setpoint", color="#2f6fb3", penwidth=1.6, label="setpoint\n(supervisor が許可)"];
  HLC -> CMD [label="setpoint", color="#2f6fb3", penwidth=1.6, label="setpoint\n(supervisor が許可)"];
  CMD -> SUP [label="setpoint (監視)"];
  CMD -> CA [label="setpoint"];
