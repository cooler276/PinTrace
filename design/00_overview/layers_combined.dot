// 呼び出し・依存 + データフロー
// 生成元: tools/gen_layer_diagrams.py（このファイルは直接編集しない）
digraph layers {
  graph [rankdir=TB, newrank=true, compound=true, nodesep=0.25, ranksep=0.6, fontname="Yu Gothic UI", fontsize=12, labeljust=l, splines=spline];
  node [shape=box, style="rounded,filled", fillcolor=white, fontname="Yu Gothic UI", fontsize=10, height=0.4];
  edge [fontname="Yu Gothic UI", fontsize=8, arrowsize=0.6];
  subgraph cluster_L5 {
    label="L5 アプリケーション層"; style="rounded,filled"; fillcolor="#fdeef7"; color="#d49ac0";
    APP [label="アプリ層
(cf2 では無効)"];
    HLC [label="high-level commander
+ planner"];
    LLC [label="低レベル commander"];
    LOC [label="測位
lighthouse / localization"];
    STAB [label="スタビライザ
1 kHz ループ", fillcolor="#ffe3f1", penwidth=1.5];
    { rank=same; APP HLC LLC LOC STAB; }
    CMD [label="commander
(優先度管理)"];
    EST [label="状態推定"];
    SUP [label="supervisor"];
    CA [label="衝突回避"];
    CTRL [label="制御"];
    PD [label="出力分配"];
    { rank=same; CMD EST SUP CA CTRL PD; }
  }
  subgraph cluster_L4 {
    label="L4 デッキ層"; style="rounded,filled"; fillcolor="#eaf7f2"; color="#8cc7ae";
    DMGR [label="デッキ管理
検出・照合"];
    DDRV [label="デッキドライバ
Flow / Loco / LH ..."];
    DAPI [label="デッキ API
GPIO / SPI / ADC"];
    { rank=same; DMGR DDRV DAPI; }
  }
  subgraph cluster_L3 {
    label="L3 基盤サービス層"; style="rounded,filled"; fillcolor="#fff4e6"; color="#e0b27a";
    SYS [label="system
起動・自己テスト"];
    CRTP [label="CRTP ルータ
+ console"];
    PL [label="param / log"];
    MEM [label="mem"];
    PEER [label="周辺機体の位置テーブル
peer localization"];
    WRK [label="worker"];
    UTL [label="共通部品
utils"];
    { rank=same; SYS CRTP PL MEM PEER WRK UTL; }
  }
  subgraph cluster_L2 {
    label="L2 ハード抽象化層"; style="rounded,filled"; fillcolor="#e9f6fb"; color="#86bfd6";
    SENS [label="センサ統合"];
    LINK [label="CRTP リンク
radiolink / usblink"];
    SLK [label="syslink"];
    PM [label="電源管理"];
    STO [label="ストレージ"];
    LEDS [label="LED / ブザー"];
    { rank=same; SENS LINK SLK PM STO LEDS; }
  }
  subgraph cluster_L1D {
    label="L1 ドライバ層（デバイスドライバ）"; style="rounded,filled"; fillcolor="#edf7e9"; color="#99c98a";
    DEV_IMU [label="IMU ドライバ
bmi088 / bmp3"];
    DEV_EEP [label="EEPROM ドライバ
eeprom / configblock"];
    DEV_MOT [label="モータドライバ
motors"];
    { rank=same; DEV_IMU DEV_EEP DEV_MOT; }
  }
  subgraph cluster_L1B {
    label="L1 ドライバ層（バスドライバ）"; style="rounded,filled"; fillcolor="#e3f1dc"; color="#86b877";
    I2C3DRV [label="I2C3 ドライバ
i2cdev / i2c_drv"];
    I2C1DRV [label="I2C1 ドライバ
i2cdev / i2c_drv"];
    UART [label="uart_syslink
(USART6)"];
    EXTI [label="exti
割り込みの振り分け"];
    WDG [label="watchdog"];
    { rank=same; I2C3DRV I2C1DRV UART EXTI WDG; }
  }
  subgraph cluster_L0 {
    label="L0 プラットフォーム・OS 層"; style="rounded,filled"; fillcolor="#f1efff"; color="#aaa1dd";
    PLAT [label="platform
機種差分"];
    RTOS [label="FreeRTOS"];
    LIB [label="ベンダライブラリ
StdPeriph / USB / CMSIS"];
    { rank=same; PLAT RTOS LIB; }
  }
  subgraph cluster_HW {
    label="HW ハードウェア"; style="rounded,filled"; fillcolor="#f2f2f2"; color="#9a9a9a";
    P_USART6 [label="USART6 + DMA"];
    P_USB [label="USB OTG FS"];
    P_I2C1 [label="I2C1 + DMA"];
    P_SPI1 [label="SPI1 + DMA"];
    P_I2C3 [label="I2C3 + DMA"];
    P_EXTI [label="EXTI"];
    P_TIM [label="TIM2 / TIM4
PWM"];
    { rank=same; P_USART6 P_USB P_I2C1 P_SPI1 P_I2C3 P_EXTI P_TIM; }
    X_NRF [label="nRF51"];
    X_EEP [label="EEPROM チップ
24AA64F"];
    X_DECK [label="デッキ"];
    X_IMU [label="BMI088 / BMP388"];
    X_MOT [label="ブラシモータ ×4"];
    { rank=same; X_NRF X_EEP X_DECK X_IMU X_MOT; }
  }
  APP -> HLC [color="#b0b0b0"];
  HLC -> CMD [color="#2f6fb3", penwidth=1.8];
  LLC -> CMD [color="#2f6fb3", penwidth=1.8];
  STAB -> CMD [color="#b0b0b0"];
  STAB -> HLC [color="#b0b0b0"];
  STAB -> EST [color="#b0b0b0"];
  STAB -> SUP [color="#b0b0b0"];
  STAB -> CA [color="#b0b0b0"];
  STAB -> CTRL [color="#b0b0b0"];
  STAB -> PD [color="#b0b0b0"];
  CA -> PEER [color="#b0b0b0"];
  LOC -> PEER [color="#2f6fb3", penwidth=1.8];
  LOC -> EST [color="#2f6fb3", penwidth=1.8];
  STAB -> SENS [color="#b0b0b0"];
  PD -> DEV_MOT [color="#2f6fb3", penwidth=1.8];
  PD -> PM [color="#b0b0b0"];
  DMGR -> DDRV [color="#b0b0b0"];
  DDRV -> DAPI [color="#b0b0b0"];
  DAPI -> LIB [color="#b0b0b0"];
  DMGR -> SLK [color="#b0b0b0"];
  DMGR -> I2C1DRV [color="#b0b0b0"];
  EST -> DDRV [dir=back, color="#2f6fb3", penwidth=1.8, style=bold];
  STAB -> SYS [dir=back, style="dashed,bold", color="#c05050"];
  DMGR -> SYS [dir=back, style="dashed,bold", color="#c05050"];
  LLC -> CRTP [dir=back, color="#2f6fb3", penwidth=1.8, style=bold];
  LOC -> CRTP [dir=back, color="#2f6fb3", penwidth=1.8, style=bold];
  CRTP -> LINK [color="#b0b0b0"];
  PL -> WRK [color="#b0b0b0"];
  PL -> STO [color="#b0b0b0"];
  SENS -> DEV_IMU [color="#b0b0b0"];
  EST -> SENS [dir=back, color="#2f6fb3", penwidth=1.8, style=bold];
  LINK -> SLK [color="#b0b0b0"];
  PM -> SLK [color="#b0b0b0"];
  SLK -> UART [color="#b0b0b0"];
  STO -> DEV_EEP [color="#b0b0b0"];
  DEV_IMU -> I2C3DRV [color="#b0b0b0"];
  DEV_EEP -> I2C1DRV [color="#b0b0b0"];
  SENS -> EXTI [dir=back, color="#2f6fb3", penwidth=1.8, style=bold];
  I2C3DRV -> LIB [color="#b0b0b0"];
  I2C1DRV -> LIB [color="#b0b0b0"];
  UART -> LIB [color="#b0b0b0"];
  DEV_MOT -> LIB [color="#b0b0b0"];
  EXTI -> LIB [color="#b0b0b0"];
  WDG -> LIB [color="#b0b0b0"];
  SYS -> WDG [color="#b0b0b0"];
  LINK -> LIB [color="#b0b0b0"];
  WRK -> RTOS [color="#b0b0b0"];
  SYS -> PLAT [color="#b0b0b0"];
  LIB -> P_USART6 [color="#b0b0b0"];
  LIB -> P_USB [color="#b0b0b0"];
  LIB -> P_I2C1 [color="#b0b0b0"];
  LIB -> P_SPI1 [color="#b0b0b0"];
  LIB -> P_I2C3 [color="#b0b0b0"];
  LIB -> P_EXTI [color="#b0b0b0"];
  LIB -> P_TIM [color="#b0b0b0"];
  X_IMU -> P_I2C3 [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_I2C3 -> I2C3DRV [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  I2C3DRV -> DEV_IMU [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  DEV_IMU -> SENS [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  X_IMU -> P_EXTI [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_EXTI -> EXTI [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SENS -> SUP [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SENS -> CTRL [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  EST -> CMD [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  EST -> HLC [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  EST -> CA [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  EST -> CTRL [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SUP -> EST [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  CRTP -> HLC [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  CMD -> SUP [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  CMD -> CA [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  CA -> SUP [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SUP -> CTRL [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SUP -> LLC [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  PEER -> CA [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  CTRL -> PD [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  PM -> PD [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SUP -> DEV_MOT [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  DEV_MOT -> P_TIM [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_TIM -> X_MOT [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  X_DECK -> P_SPI1 [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_SPI1 -> DAPI [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  DAPI -> DDRV [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  X_NRF -> P_USART6 [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_USART6 -> UART [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  UART -> SLK [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_USB -> LINK [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SLK -> LINK [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SLK -> PM [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  SLK -> DMGR [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  LINK -> CRTP [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  CRTP -> PL [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  CRTP -> MEM [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  X_EEP -> P_I2C1 [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_I2C1 -> I2C1DRV [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  I2C1DRV -> DEV_EEP [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  DEV_EEP -> STO [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  STO -> PL [color="#2f6fb3", fontcolor="#2f6fb3", penwidth=1.6, constraint=false];
  P_USART6 -> X_NRF [dir=none, style=dotted, penwidth=1.4, color="#8a8a8a", fontcolor="#8a8a8a", label="UART"];
  P_I2C1 -> X_EEP [dir=none, style=dotted, penwidth=1.4, color="#8a8a8a", fontcolor="#8a8a8a", label="I2C"];
  P_I2C1 -> X_DECK [dir=none, style=dotted, penwidth=1.4, color="#8a8a8a", fontcolor="#8a8a8a", label="I2C"];
  P_SPI1 -> X_DECK [dir=none, style=dotted, penwidth=1.4, color="#8a8a8a", fontcolor="#8a8a8a", label="SPI"];
  P_I2C3 -> X_IMU [dir=none, style=dotted, penwidth=1.4, color="#8a8a8a", fontcolor="#8a8a8a", label="I2C"];
  P_EXTI -> X_IMU [dir=none, style=dotted, penwidth=1.4, color="#8a8a8a", fontcolor="#8a8a8a", label="INT"];
  P_TIM -> X_MOT [dir=none, style=dotted, penwidth=1.4, color="#8a8a8a", fontcolor="#8a8a8a", label="PWM"];
  APP -> CMD -> DMGR -> SYS -> SENS -> DEV_IMU -> I2C3DRV -> PLAT -> P_USART6 -> X_NRF [style=invis, weight=10];
}
